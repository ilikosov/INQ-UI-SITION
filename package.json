{
  "name": "inq-ui-sition",
  "version": "0.1.0",
  "description": "Mobile-first CSS-in-JS React component framework built with TypeScript and Stitches.",
  "keywords": [
    "react",
    "ui",
    "design-system",
    "stitches",
    "typescript",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/inq-ui-sition/inq-ui-sition#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inq-ui-sition/inq-ui-sition.git"
  },
  "bugs": {
    "url": "https://github.com/inq-ui-sition/inq-ui-sition/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "assets/logo.svg"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run lint && npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.17.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "@vanilla-extract/esbuild-plugin": "^2.3.17"
  }
}
